# =========================================================
#  .gitignore — Ruta App
# =========================================================

# ---------- Sistema operativo / editor ----------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.iml

# ---------- Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# ---------- Artefactos generados de la propuesta ----------
# (build-pdf.sh genera estos HTML intermedios)
propuesta-cliente/_body.html
propuesta-cliente/_build.html

# ---------- Logs y temporales ----------
*.log
*.tmp
tmp/

# ---------- Entornos / secretos ----------
.env
.env.*
!.env.example

# ---------- Android / Gradle (para el futuro desarrollo) ----------
.gradle/
build/
local.properties
*.apk
*.aab
*.keystore
!debug.keystore
.cxx/
*.hprof

# ---------- Java / Kotlin ----------
*.class
*.jar
!.gradle/wrapper/gradle-wrapper.jar

# ---------- iOS (si se agrega en el futuro) ----------
Pods/
*.xcworkspace
xcuserdata/
